# GEMINI_API_KEY: Optional if using remote Gemini 3.8 Flash inference.
# Not required when using local Gemma via Ollama or the Deterministic Parser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for self-referential links
APP_URL="MY_APP_URL"

# OLLAMA_ENDPOINT: Default local Ollama endpoint (runs locally on port 11434)
OLLAMA_ENDPOINT="http://127.0.0.1:11434"

# PORT: Server listening port (default: 3000)
PORT="3000"
